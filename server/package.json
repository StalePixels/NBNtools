{
  "name": "nbn-server",
  "version": "2.0.0",
  "description": "Next Best Network protocol server library, and PersonalServer",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "repository": "https://github.com/StalePixels/NBNtools",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node build/main.js",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
