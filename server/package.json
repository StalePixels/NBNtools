{
  "name": "nbn-server",
  "version": "2.0.0",
  "description": "Next Best Network protocol server library, and PersonalServer",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "repository": "https://github.com/StalePixels/NBNtools",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node build/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1"
  }
}
